# ---- Crucible config -------------------------------------------------------
# Copy this file to ".env" and fill in your key. NEVER commit the real .env.

# Which AI provider the backend uses for generation + grading.
#   anthropic = Anthropic Developer API (pay-as-you-go, NOT your Max plan)
#   local     = an OpenAI-compatible local server (e.g. Ollama) for $0 runtime
AI_PROVIDER=anthropic

# ---- Anthropic (AI_PROVIDER=anthropic) ------------------------------------
# Get a key at https://console.anthropic.com . This is billed per-token and is
# separate from any Claude Max/Pro subscription. Set a spend cap in the Console.
ANTHROPIC_API_KEY=

# Model tiers (verified current strings). Grading = quality; generation = cheap.
ANTHROPIC_GRADING_MODEL=claude-sonnet-4-6
ANTHROPIC_GENERATION_MODEL=claude-haiku-4-5

# ---- Local provider (AI_PROVIDER=local) -----------------------------------
# Point at any OpenAI-compatible endpoint. Trades grading quality for $0 cost.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_GRADING_MODEL=llama3.1:8b
LOCAL_GENERATION_MODEL=llama3.1:8b

# ---- Server ---------------------------------------------------------------
PORT=4000
