{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first IB interview-prep app (HK Summer Analyst 2027)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "smoke": "npm run smoke --workspace server",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
